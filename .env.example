# Backend only. Public CMR discovery normally needs no token.
EARTHDATA_TOKEN=
# Explicit server-side selection; no automatic fallback between methods.
# earthdata_token preserves the original behavior. Select earthdata_password
# to use the verified Harmony-Py EDL redirect/cookie session.
HARMONY_AUTH_MODE=earthdata_token
EDL_USERNAME=
EDL_PASSWORD=
# Selected credentials and this exact opt-in are required for any real job.
# Keep false until ready for ONE small first-scene extraction.
HARMONY_PROCESSING_ENABLED=false
CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CMR_TIMEOUT_SECONDS=30
CMR_CACHE_SECONDS=300
# Optional frontend public API URL; leave empty to use Vite's /api proxy.
# Required for a production build: the HTTPS Render origin, without /api.
VITE_API_BASE_URL=
# Local default. Render sets production explicitly and never loads this file.
FORESTPULSE_ENV=development
# Optional absolute writable cache directory. Production defaults to OS temp.
# FORESTPULSE_CACHE_DIR=
